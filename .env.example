# Vercel > Project > Settings > Environment Variables bölümüne bunları gir.
# (Bu dosyaya GERÇEK değer yazma, sadece örnek.)

# BotFather'dan aldığın bot token'ı
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook gizli anahtarı: kendin uydur (sadece harf, rakam, _ ve -), en az 24 karakter
WEBHOOK_SECRET=uzun_rastgele_bir_anahtar_buraya_yaz

# Supabase > Project Settings > API
SUPABASE_URL=https://gidvxryekcglkanucgpt.supabase.co
# Gizli (secret / service_role) anahtar — ASLA istemci koduna veya GitHub'a koyma
SUPABASE_SERVICE_ROLE_KEY=

# Opsiyonel
ADMIN_USERNAME=easycheatsupport
# APP_URL=https://senin-alanadin.com        (boşsa otomatik algılanır)
# TG_APP_SHORT=app                           (BotFather'da /newapp ile oluşturduğun kısa ad)
